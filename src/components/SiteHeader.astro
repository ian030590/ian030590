---
interface Props { path: string }
const { path } = Astro.props;
const links = [
  { href: '/', label: '首頁' },
  { href: '/projects', label: '開源專案' },
  { href: '/blog', label: '專業文章' },
  { href: '/contact', label: '聯絡我' },
  { href: '/sponsor', label: '贊助我' },
];
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">
      <img src="/icons/logo.png" alt="蔡泓恩 職能治療師 Logo" class="brand-logo" width="36" height="36" />
      <span class="brand-text"><strong>蔡泓恩</strong><span>職能治療師 · Ian Tsai</span></span>
    </a>
    <nav class="nav-links" aria-label="主要導覽">
      {links.map(({ href, label }) => (
        <a class:list={['nav-link', { active: path === href }]} href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" aria-label="切換深色模式" title="切換深色模式">
      <svg class="icon-dark" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" /></svg>
      <svg class="icon-light" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="display: none;"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
    </button>
    <button class="menu-button" type="button" aria-label="開啟選單" aria-expanded="false" aria-controls="mobile-panel">
      <span class="animate-icon animate-icon--menu" data-animate-icon="menu" aria-hidden="true"></span>
    </button>
  </div>
  <nav id="mobile-panel" class="mobile-panel" aria-label="行動版導覽">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>
