---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArticleList from '../components/ArticleList.astro';
const metadata = {
  "title": "專業文章與專題 | 蔡泓恩 | 職能治療師",
  "description": "分享 AI 產品架構思維、視覺復健、職能治療與數位健康工具開發的深度臨床觀察與實務筆記。",
  "socialTitle": "專業文章與專題｜蔡泓恩 職能治療師",
  "path": "/blog",
  "schema": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://ian030590.trainerhub.cc/#person",
        "name": "蔡泓恩",
        "alternateName": "Hung-En (Ian) Tsai",
        "jobTitle": "職能治療師",
        "url": "https://ian030590.trainerhub.cc/",
        "email": "rainbowh9490@gmail.com",
        "sameAs": [
          "https://github.com/ian030590",
          "https://trainerhub.cc"
        ],
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "國立臺灣大學"
        },
        "knowsAbout": [
          "職能治療",
          "神經復健",
          "視覺復健",
          "低視能評估",
          "數位醫療",
          "AI系統架構",
          "居家復能"
        ]
      },
      {
        "@type": "CollectionPage",
        "@id": "https://ian030590.trainerhub.cc/blog#collection",
        "name": "專業文章與專題",
        "url": "https://ian030590.trainerhub.cc/blog",
        "inLanguage": "zh-TW",
        "author": {
          "@id": "https://ian030590.trainerhub.cc/#person"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "首頁",
            "item": "https://ian030590.trainerhub.cc/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "專業文章",
            "item": "https://ian030590.trainerhub.cc/blog"
          }
        ]
      }
    ]
  },
  "articles": true
};
---
<SiteLayout {...metadata}>
    <main class="page-main">
      <div class="container">
        <header class="blog-header">
          <div class="section-kicker">Clinical & Tech Insights</div>
          <h1 class="page-title">專業文章與技術洞察</h1>
          <p class="page-intro">
            結合職能治療臨床觀察、AI 產品架構思維與數位健康工具開發的深度實務筆記。
          </p>
        </header>

        <div class="blog-layout">
          <!-- Main Content: Articles Feed -->
          <div class="blog-main-content">
            <div id="filter-status-bar" class="filter-status-bar" style="display: none;">
              <div class="filter-status-info">
                <span class="filter-status-label">目前篩選：</span>
                <span id="active-filter-name" class="filter-status-value">全部文章</span>
                <span id="active-filter-count" class="filter-status-count"></span>
              </div>
              <button id="clear-filter-btn" class="clear-filter-btn" type="button" aria-label="清除篩選">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
                清除篩選
              </button>
            </div>

            <div id="article-content" role="region" aria-label="文章列表" tabindex="-1">
              <ArticleList />
            </div>
          </div>

          <!-- Right Sidebar: Search, Tags Filter & Subscriptions -->
          <aside class="blog-sidebar" aria-label="文章分類與篩選">
            <!-- Search Widget -->
            <div class="sidebar-widget search-widget">
              <label for="blog-search" class="widget-title">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                搜尋文章
              </label>
              <div class="search-input-wrap">
                <input
                  type="search"
                  id="blog-search"
                  placeholder="搜尋標題、內容或關鍵字..."
                  aria-label="搜尋文章"
                  autocomplete="off"
                />
                <button id="clear-search-btn" class="clear-search-btn" type="button" aria-label="清除搜尋" style="display: none;">
                  <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
              </div>
            </div>

            <!-- Categories / Tags Filter Widget -->
            <div class="sidebar-widget tags-widget">
              <div class="widget-header">
                <h2 class="widget-title">
                  <span class="material-symbols-outlined" aria-hidden="true">label</span>
                  主題標籤分類
                </h2>
                <span id="tags-count-badge" class="widget-badge">6 個主題</span>
              </div>
              <div id="tags-filter-list" class="tags-filter-list">
                <!-- Tag buttons populated dynamically -->
              </div>
            </div>

            <!-- Core Categories & Series Widget -->
            <div class="sidebar-widget info-widget">
              <h2 class="widget-title">
                <span class="material-symbols-outlined" aria-hidden="true">category</span>
                推薦主題分類
              </h2>
              <p class="widget-description">
                點擊快速篩選精選復健與科技主題文章：
              </p>
              <div class="widget-actions">
                <button
                  type="button"
                  class="button-secondary widget-button tag-filter-quick-btn"
                  data-quick-tag="中風復健"
                >
                  <span class="material-symbols-outlined" aria-hidden="true">health_and_safety</span>
                  中風復健
                </button>
                <button
                  type="button"
                  class="button-secondary widget-button tag-filter-quick-btn"
                  data-quick-tag="視覺復健"
                >
                  <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                  視覺復健
                </button>
                <button
                  type="button"
                  class="button-secondary widget-button tag-filter-quick-btn"
                  data-quick-tag="動作復健"
                >
                  <span class="material-symbols-outlined" aria-hidden="true">accessibility_new</span>
                  動作復健
                </button>
                <button
                  type="button"
                  class="button-secondary widget-button tag-filter-quick-btn"
                  data-quick-tag="認知復健"
                >
                  <span class="material-symbols-outlined" aria-hidden="true">psychology</span>
                  認知復健
                </button>
                <button
                  type="button"
                  class="button-secondary widget-button tag-filter-quick-btn"
                  data-quick-tag="數位學習"
                >
                  <span class="material-symbols-outlined" aria-hidden="true">school</span>
                  數位學習
                </button>
                <button
                  type="button"
                  class="button-secondary widget-button tag-filter-quick-btn"
                  data-quick-tag="AI應用"
                >
                  <span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>
                  AI應用
                </button>
              </div>
            </div>

            <!-- TrainerHub Feature Widget -->
            <div class="sidebar-widget feature-platform-widget">
              <div class="widget-header">
                <h2 class="widget-title">
                  <span class="material-symbols-outlined" aria-hidden="true">neurology</span>
                  居家復健訓練網
                </h2>
              </div>
              <p class="widget-description">
                將實證醫學指引落實於日常練習。<strong>TrainerHub (trainerhub.cc)</strong> 提供動作、視覺掃描與認知復能的線上互動式工具。
              </p>
              <a
                href="https://trainerhub.cc"
                target="_blank"
                rel="noopener"
                class="button-primary widget-button"
                title="前往 TrainerHub 居家復健訓練網"
              >
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                前往 TrainerHub 居家訓練網
              </a>
            </div>
          </aside>
        </div>
      </div>
    </main>
</SiteLayout>
