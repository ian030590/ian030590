---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArticleList from '../components/ArticleList.astro';
const metadata = {
  "title": "專業文章與專題 | 蔡泓恩 | 職能治療師",
  "description": "蔡泓恩職能治療師整理的中風、視覺、動作與認知復健研究與臨床指引，以及數位學習與 AI 應用筆記，每篇附上原始文獻連結。",
  "socialTitle": "專業文章與專題｜蔡泓恩 職能治療師",
  "path": "/blog",
  "schema": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://ian030590.trainerhub.cc/#person",
        "name": "蔡泓恩",
        "alternateName": "Hung-En (Ian) Tsai",
        "jobTitle": "職能治療師",
        "url": "https://ian030590.trainerhub.cc/",
        "email": "rainbowh9490@gmail.com",
        "sameAs": [
          "https://github.com/ian030590",
          "https://trainerhub.cc"
        ],
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "國立臺灣大學"
        },
        "knowsAbout": [
          "職能治療",
          "神經復健",
          "視覺復健",
          "低視能評估",
          "數位醫療",
          "AI系統架構",
          "居家復能"
        ]
      },
      {
        "@type": "CollectionPage",
        "@id": "https://ian030590.trainerhub.cc/blog#collection",
        "name": "專業文章與專題",
        "url": "https://ian030590.trainerhub.cc/blog",
        "inLanguage": "zh-TW",
        "author": {
          "@id": "https://ian030590.trainerhub.cc/#person"
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "首頁",
            "item": "https://ian030590.trainerhub.cc/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "專業文章",
            "item": "https://ian030590.trainerhub.cc/blog"
          }
        ]
      }
    ]
  },
  "articles": true
};
---
<SiteLayout {...metadata}>
    <main class="page-main">
      <div class="container">
        <header class="blog-header">
          <h1 class="page-title">專業文章</h1>
          <p class="page-intro">
            整理中風、視覺、動作與認知復健的研究與臨床指引，也記錄數位學習與 AI 應用的筆記。
          </p>
        </header>

        <div class="blog-layout">
          <div class="blog-main-content">
            <div id="filter-status-bar" class="filter-status-bar" hidden>
              <p class="filter-status-info">
                <span class="filter-status-label">目前篩選：</span>
                <span id="active-filter-name" class="filter-status-value">全部文章</span>
                <span id="active-filter-count" class="filter-status-count"></span>
              </p>
              <button id="clear-filter-btn" class="clear-filter-btn" type="button">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
                清除篩選
              </button>
            </div>

            <div id="article-content" role="region" aria-label="文章列表" tabindex="-1">
              <ArticleList />
            </div>
          </div>

          <aside class="blog-sidebar" aria-label="文章搜尋與篩選">
            <div class="sidebar-widget search-widget">
              <label for="blog-search" class="widget-title">
                <span class="material-symbols-outlined" aria-hidden="true">search</span>
                搜尋文章
              </label>
              <div class="search-input-wrap">
                <input
                  type="search"
                  id="blog-search"
                  placeholder="搜尋標題、摘要或標籤"
                  autocomplete="off"
                />
                <button id="clear-search-btn" class="clear-search-btn" type="button" aria-label="清除搜尋" hidden>
                  <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
              </div>
            </div>

            <div class="sidebar-widget tags-widget">
              <h2 class="widget-title">
                <span class="material-symbols-outlined" aria-hidden="true">label</span>
                依主題篩選
              </h2>
              <div id="tags-filter-list" class="tags-filter-list"></div>
            </div>

            <div class="sidebar-widget feature-platform-widget">
              <h2 class="widget-title">居家復健訓練網</h2>
              <p class="widget-description">
                TrainerHub 提供動作、視覺、認知與口腔的居家練習工具，可在瀏覽器直接使用。
              </p>
              <a
                href="https://trainerhub.cc"
                target="_blank"
                rel="noopener"
                class="button-primary widget-button"
              >
                開啟 TrainerHub
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
              </a>
            </div>
          </aside>
        </div>
      </div>
    </main>
</SiteLayout>
