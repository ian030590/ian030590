const metadata = {
  "title": "贊助我 | 蔡泓恩 | 職能治療師",
  "description": "透過 Buy Me a Coffee 支持蔡泓恩職能治療師維護 TrainerHub 居家復健訓練網，並持續開發視覺復健與數位健康的開源工具。",
  "socialTitle": "贊助我｜蔡泓恩 職能治療師",
  "path": "/sponsor",
  "schema": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "name": "蔡泓恩",
        "jobTitle": "職能治療師",
        "email": "rainbowh9490@gmail.com",
        "sameAs": [
          "https://github.com/ian030590",
          "https://trainerhub.cc"
        ],
        "knowsAbout": [
          "職能治療",
          "視覺復健",
          "數位健康",
          "居家復能"
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "首頁",
            "item": "/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "贊助我",
            "item": "/sponsor"
          }
        ]
      }
    ]
  }
};
---
<SiteLayout {...metadata}>
    <main class="page-main sponsor-page">
      <div class="container">
        <section class="sponsor-hero" aria-labelledby="sponsor-title">
          <h1 id="sponsor-title" class="page-title">贊助我的開源工作</h1>
          <p class="page-intro">
            你的支持會幫助我持續維護居家練習網，並開發更容易取得的視覺復健與數位健康工具。
          </p>
          <div class="sponsor-hero-actions">
            <a class="button-primary has-animated-icon" href="https://buymeacoffee.com/ian030590" target="_blank" rel="noopener">
              在 Buy Me a Coffee 贊助
              <span class="animate-icon animate-icon--external-link" data-animate-icon="external-link" aria-hidden="true"></span>
            </a>
          </div>
          <p class="sponsor-handle">帳號：<strong>ian030590</strong></p>
        </section>

        <div class="sponsor-details">
          <section class="sponsor-use" aria-labelledby="use-title">
            <h2 id="use-title">贊助會用在</h2>
            <ul class="sponsor-list">
              <li>以臨床觀點整理可被實際使用的健康內容。</li>
              <li>將研究與工作現場的問題轉化為小型工具與原型。</li>
              <li>維護公開的專案、文章與知識分享。</li>
            </ul>
            <a class="text-link has-animated-icon" href="/projects">查看公開專案<span class="animate-icon animate-icon--arrow-right" data-animate-icon="arrow-right" aria-hidden="true"></span></a>
          </section>

          <div class="sponsor-notes">
            <section aria-labelledby="about-title">
              <h2 id="about-title">關於這些工作</h2>
              <p>網站上的工具與文章是我在工作之外獨立完成的，沒有商業授權綁定，也不會存取個人病歷資料。</p>
            </section>
            <section aria-labelledby="payment-title">
              <h2 id="payment-title">付款方式</h2>
              <p>目前只開放 Buy Me a Coffee 單筆贊助，可用信用卡、Apple Pay 或 Google Pay，不需註冊帳號。台灣在地金流（綠界 ECPay）尚未開放。</p>
            </section>
          </div>
        </div>
      </div>
    </main>
</SiteLayout>
