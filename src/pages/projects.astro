---
import SiteLayout from '../layouts/SiteLayout.astro';
const metadata = {
  "title": "開源專案 | 蔡泓恩 | 職能治療師",
  "description": "探索蔡泓恩目前公開的 GitHub 專案：OcuTrain 眼動訓練、RehabTrainerHub 居家練習平台、研究自動化、門診通知與 PDF 工具。",
  "socialTitle": "開源專案｜蔡泓恩 職能治療師",
  "path": "/projects",
  "schema": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://ian030590.trainerhub.cc/#person",
        "name": "蔡泓恩",
        "alternateName": [
          "Hung-En (Ian) Tsai",
          "Ian Tsai",
          "蔡泓恩 職能治療師"
        ],
        "jobTitle": "職能治療師",
        "url": "https://ian030590.trainerhub.cc/",
        "image": "https://ian030590.trainerhub.cc/assets/ian-tsai.jpg",
        "email": "rainbowh9490@gmail.com",
        "sameAs": [
          "https://github.com/ian030590",
          "https://trainerhub.cc"
        ],
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "國立臺灣大學"
        },
        "knowsAbout": [
          "職能治療",
          "視覺復健",
          "數位健康",
          "居家復能"
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "首頁",
            "item": "/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "開源專案",
            "item": "/projects"
          }
        ]
      }
    ]
  },
  "projects": true
};
---
<SiteLayout {...metadata}>
    <main class="page-main">
      <div class="container">
        <header class="page-intro-header">
          <h1 class="page-title">開源專案與工具</h1>
          <p class="page-intro">
            從眼動訓練與居家練習，到研究流程與文件處理，這裡整理我目前公開的 GitHub 專案。已封存的早期作品也保留供查閱；各專案的用途、授權與使用方式請見儲存庫說明。
          </p>
        </header>

        <section class="featured-platform-banner" aria-labelledby="trainerhub-title">
          <h2 id="trainerhub-title">TrainerHub 居家復健訓練網</h2>
          <p>
            居家練習工具與衛教資訊的整合入口，提供動作、視覺、認知與口腔練習模組，以及經審核的開發者遊戲庫。支援練習參數設定、成績 CSV 匯出與 PWA 安裝；開發者遊戲於獨立網域的沙盒中執行。
          </p>
          <div class="tags">
            <span class="tag">動作與視覺練習</span>
            <span class="tag">認知與口腔練習</span>
            <span class="tag">開發者遊戲庫</span>
            <span class="tag">PWA</span>
            <span class="tag">成績 CSV 匯出</span>
          </div>
          <a class="button-primary" href="https://trainerhub.cc" target="_blank" rel="noopener">
            開啟 TrainerHub
            <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
          </a>
        </section>

        <p id="projects-status" class="projects-status" role="status" aria-live="polite"></p>
        <noscript><p class="projects-status">請開啟 JavaScript 瀏覽專案卡片，或<a href="https://github.com/ian030590?tab=repositories" target="_blank" rel="noopener noreferrer">前往 GitHub 查看所有公開專案</a>。</p></noscript>
        <div id="projects-grid" class="projects-grid">
          <p class="empty-state js-only">正在載入公開專案…</p>
        </div>
      </div>
    </main>
</SiteLayout>
