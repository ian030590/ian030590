---
import SiteLayout from '../layouts/SiteLayout.astro';
const metadata = {
  "title": "蔡泓恩 | 職能治療師",
  "description": "蔡泓恩職能治療師的個人官方網站。專注於視覺復健研究、中風神經復健、臨床實證與數位健康工具開發。",
  "socialTitle": "蔡泓恩 | 職能治療師",
  "path": "/",
  "schema": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://ian030590.trainerhub.cc/#person",
        "name": "蔡泓恩",
        "alternateName": [
          "Hung-En (Ian) Tsai",
          "Ian Tsai",
          "蔡泓恩 職能治療師"
        ],
        "jobTitle": "職能治療師",
        "url": "https://ian030590.trainerhub.cc/",
        "image": "https://ian030590.trainerhub.cc/assets/ian-tsai.jpg",
        "email": "rainbowh9490@gmail.com",
        "sameAs": [
          "https://github.com/ian030590",
          "https://trainerhub.cc"
        ],
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "國立臺灣大學"
        },
        "knowsAbout": [
          "職能治療",
          "中風復健",
          "神經復健",
          "視覺復健",
          "低視能評估",
          "數位醫療",
          "AI應用",
          "居家復能"
        ],
        "description": "蔡泓恩，職能治療師，專注於神經復健、視覺復健評估、開源數位醫療工具與臨床研究實證轉化。"
      },
      {
        "@type": "WebSite",
        "@id": "https://ian030590.trainerhub.cc/#website",
        "url": "https://ian030590.trainerhub.cc/",
        "name": "蔡泓恩 | 職能治療師",
        "description": "蔡泓恩職能治療師的個人官方網站。專注於視覺復健研究、中風神經復健、臨床實證與數位健康工具開發。",
        "publisher": {
          "@id": "https://ian030590.trainerhub.cc/#person"
        },
        "inLanguage": "zh-TW"
      }
    ]
  }
};
---
<SiteLayout {...metadata}>
    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div>
            <div class="eyebrow">蔡泓恩 職能治療師 · Occupational Therapist & Digital Health</div>
            <h1>
              把臨床觀察<br />
              <span>轉化為可用的復健工具</span>
            </h1>
            <p class="hero-copy">
              我是蔡泓恩，一名熱衷於將科技引入醫療中的職能治療師。專注於視覺復健、視覺評估與臨床研究，讓專業知識更靠近日常生活。
            </p>
            <div class="hero-actions">
              <a class="button-primary" href="/blog">
                查看文章
                <span class="material-symbols-outlined" aria-hidden="true"
                  >arrow_forward</span
                >
              </a>
              <a class="button-secondary" href="mailto:rainbowh9490@gmail.com"
                >預約交流</a
              >
            </div>
          </div>
          <div class="portrait">
            <img src="/assets/ian-tsai.jpg" alt="蔡泓恩，職能治療師" />
          </div>
        </div>
      </section>

      <section class="section section-muted">
        <div class="container">
          <div class="section-intro">
            <div class="section-kicker">Focus areas</div>
            <h2>核心專業領域</h2>
            <p>
              整合職能科學、臨床證據與AI，建立能夠真正支持個案與臨床團隊的解決方案。
            </p>
          </div>
          <div class="expertise-grid">
            <article class="expertise-card">
              <div class="icon-box">
                <span class="material-symbols-outlined" aria-hidden="true"
                  >visibility</span
                >
              </div>
              <h3>視覺復健</h3>
              <p>
                針對視野缺損、半側忽略與眼球動作控制問題，設計視覺掃描與注意力訓練。
              </p>
            </article>
            <article class="expertise-card">
              <div class="icon-box">
                <span class="material-symbols-outlined" aria-hidden="true"
                  >fact_check</span
                >
              </div>
              <h3>功能性評估</h3>
              <p>
                從日常活動需求出發，辨識影響獨立生活的視覺障礙，作為治療計畫的基準。
              </p>
            </article>
            <article class="expertise-card">
              <div class="icon-box">
                <span class="material-symbols-outlined" aria-hidden="true"
                  >code</span
                >
              </div>
              <h3>數位健康工具</h3>
              <p>
                以可近用的介面與自動化流程，協助治療師減少行政負擔、保留更多臨床時間。
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section section-platform-highlight">
        <div class="container">
          <div class="platform-highlight-card">
            <div class="platform-highlight-header">
              <div class="section-kicker">Digital Rehabilitation Platform</div>
              <h2>TrainerHub 居家復健訓練網</h2>
              <p class="platform-highlight-desc">
                專為中風復健、視野障礙與高齡認知設計的互動式數位復能平台。整合動作控制、微視野注視、視覺搜尋與反應時間訓練，讓實證臨床介入延伸至每日居家自主練習。
              </p>
            </div>
            <div class="platform-highlight-features">
              <div class="platform-feature-item">
                <span class="material-symbols-outlined" aria-hidden="true">fitness_center</span>
                <strong>動作與手眼協調</strong>
                <span>結合反應時間與目標追蹤</span>
              </div>
              <div class="platform-feature-item">
                <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                <strong>視覺與空間注意</strong>
                <span>微視野掃描與偏心注視訓練</span>
              </div>
              <div class="platform-feature-item">
                <span class="material-symbols-outlined" aria-hidden="true">psychology</span>
                <strong>日常認知與推理</strong>
                <span>記憶、步驟排序與執行功能</span>
              </div>
              <div class="platform-feature-item">
                <span class="material-symbols-outlined" aria-hidden="true">devices</span>
                <strong>即開即用 PWA</strong>
                <span>安全沙盒隔離，跨裝置免安裝</span>
              </div>
            </div>
            <div class="platform-highlight-actions">
              <a class="button-primary" href="https://trainerhub.cc" target="_blank" rel="noopener" title="造訪 TrainerHub 居家復健訓練網">
                前往體驗 TrainerHub 居家訓練網
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-intro">
            <div class="section-kicker">Experience &amp; education</div>
            <h2>學經歷</h2>
            <p>持續在臨床實踐、研究與數位工具開發之間建立連結。</p>
          </div>
          <div id="experience-list" class="timeline"></div>
        </div>
      </section>
    </main>
</SiteLayout>
