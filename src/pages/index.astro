---
import SiteLayout from '../layouts/SiteLayout.astro';
import TrainerHubPreview from '../components/TrainerHubPreview.astro';
import '../styles/home.css';

const work = [
  {
    period: '2025/1 至今',
    title: '研究助理',
    org: '社團法人台灣視覺復健專業服務協會',
    description: '負責勞動部研究計畫申請與報告撰寫、研究收案、視覺評估、視覺復健、研究行政與資料處理；並以 AI 建置及維護門診病歷與研究個案紀錄系統。',
  },
  {
    period: '2023/9 至 2024/12',
    title: '專任研究助理',
    org: '臺北市立聯合醫院',
    description: '執行內分泌與新陳代謝科及眼科部研究收案，協助國科會研究行政、研究倫理申請、個案管理，以及視覺評估與視覺復健。',
  },
];
const education = [
  {
    period: '2025/2 至 2026/12｜就讀中',
    title: '職能治療學系 碩士',
    org: '國立臺灣大學',
    description: '研究聚焦於視覺功能評估、視覺復能與臨床研究，探討雙眼視覺功能、深度知覺與眼球動作特徵。',
  },
  {
    period: '2019/9 至 2023/6｜畢業',
    title: '職能治療學系 學士',
    org: '國立臺灣大學',
    description: '建立職能治療臨床推理、視覺復健與跨專業協作的基礎，並延伸投入臨床研究與數位健康工具開發。',
  },
];

const thesisProject = {
  category: '碩士論文研究',
  status: '論文計畫書 · 115 年 9 月',
  title: '以模擬單眼視覺損傷探討雙眼視功能受限對遠近距離深度知覺任務表現與眼動特徵之影響',
  institution: '國立臺灣大學醫學院職能治療學系碩士班',
  advisor: '指導教授：蔡麗婷 副教授',
};

const publications = [
  {
    year: '2026',
    date: '2026/04',
    type: '壁報發表',
    badgeClass: 'academic-badge--poster',
    title: '職災勞工立體視覺評估之臨床挑戰：不同評估工具之信度、敏感度與標準化之範疇審查',
    englishTitle: 'Clinical Challenges in Stereopsis Assessment for Injured Workers: A Scoping Review of Reliability, Sensitivity, and Standardization across Testing Modalities',
    conference: '臺灣大學職能治療學系學術研討會（畢業聯展）',
    authors: '蔡泓恩、蔡麗婷',
    summary: '針對 16 種立體視覺評估工具進行範疇審查，分析圖卡與電腦化測驗在動態職場環境預測力的落差，提出建構任務導向功能性立體視覺工作樣本之迫切需求。',
  },
  {
    year: '2025',
    date: '2025/12',
    type: '壁報發表',
    badgeClass: 'academic-badge--poster',
    title: '學齡兒童低視能之視覺輔具需求探討：臺大醫院低視能門診之臨床研究',
    englishTitle: 'Exploring the Needs of Visual Assistive Devices for Pediatric Low Vision: A Case Study from the National Taiwan University Hospital Low Vision Clinic',
    conference: '校園與特殊教育領域之視力健康研討會',
    authors: '蔡泓恩、宮圓媛、林翊楟、翁祥庭、陳欣娸、蘇乾嘉、侯鈞賀、蔡麗婷',
    summary: '回溯分析臺大醫院眼科低視能門診 18 歲以下學齡個案就診資料，探討視力損傷嚴重度與各類視覺輔具於學校學習環境中的實際配處需求。',
  },
  {
    year: '2025',
    date: '2025/11',
    type: '壁報發表',
    badgeClass: 'academic-badge--poster',
    title: '單眼遮蔽訓練於外傷性視神經病變之視覺與功能成效：個案報告',
    englishTitle: 'Monocular Eye Patching for Traumatic Optic Neuropathy: A Case Report on Visual and Functional Outcomes',
    conference: '臺灣職能治療學會第 44 次學術研討會',
    authors: '蔡泓恩、侯鈞賀、蔡麗婷',
    summary: '記錄 28 歲外傷性視神經病變個案接受 6 週單眼遮蔽與視覺訓練介入，評估其視力、視野注意力（UFOV）、立體視覺與工作樣本表現之功能改善歷程。',
  },
  {
    year: '2025',
    date: '2025/08',
    type: '口頭報告',
    badgeClass: 'academic-badge--oral',
    title: '提升評估整體性：發展糖尿病特定視覺生活品質量表',
    englishTitle: 'Development of a Diabetes-Specific Visual-Related Quality of Life Questionnaire to Improve Comprehensive Assessment',
    conference: '台灣視覺復健專業服務協會（TAVR）2025 低視能雙年會',
    authors: '蔡泓恩、廖國盟、蔡麗婷',
    summary: '結合系統性文獻回顧與病人自報結果測量（PROM）方法學，彙整題庫並於北市聯醫忠孝院區完成 47 位糖尿病患者認知訪談，經專家審查達成優異內容效度（S-CVI 0.98）。',
  },
  {
    year: '2025',
    date: '2025/04',
    type: '壁報發表',
    badgeClass: 'academic-badge--poster',
    title: '探討臺灣不同嚴重度低視能患者之視覺相關日常生活功能及輔具需求：以臺大醫院眼科低視能門診為例',
    englishTitle: 'Exploring Visual-Related Daily Living Function and Assistive Device Needs Among People with Varying Severities of Low Vision in Taiwan: A Study at the Low Vision Clinic of National Taiwan University Hospital',
    conference: '臺灣大學職能治療學系學術研討會',
    authors: '蔡泓恩、宮圓媛、翁祥庭、陳欣娸、蘇乾嘉、侯鈞賀、蔡麗婷',
    summary: '分析臺大醫院跨年齡層低視能門診個案之臨床資料，探討不同視力殘存水準在自主生活、閱讀與移行功能上的限制及輔具配置樣態。',
  },
  {
    year: '2023',
    date: '2023/11',
    type: '壁報發表',
    badgeClass: 'academic-badge--poster',
    title: '導航介入在中風患者功能性移行能力之成效：文獻回顧與個案報告',
    englishTitle: 'Navigation Intervention to Improve Functional Mobility in a Person with Stroke: A Review and a Case Report',
    conference: '中華民國眼科醫學會第 64 次學術研討會（TOST 2023，PO-073）',
    authors: '蔡泓恩、蔡麗婷、侯鈞賀',
    summary: '回顧 15 篇中風導航障礙文獻，針對順行性空間定向障礙個案施行 3 個月醫院與社區實境導航介入，驗證視空間注意力與生活移行能力之改善。',
  },
];
const metadata = {
  "title": "蔡泓恩 | 職能治療師",
  "description": "蔡泓恩職能治療師的個人官方網站。專注於視覺復健研究、中風神經復健、臨床實證與數位健康工具開發。",
  "socialTitle": "蔡泓恩 | 職能治療師",
  "path": "/",
  "schema": {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://ian030590.trainerhub.cc/#person",
