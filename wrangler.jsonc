{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ian",
  "compatibility_date": "2026-10-19",
  // Cloudflare serves dist/ directly; the Worker script only handles /api/*
  // (the contact form and the public Blogger article catalog).
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Same as Pages: /x.html redirects to /x, and /x serves x.html.
    "html_handling": "auto-trailing-slash",
    // Serve 404.html with a 404 status instead of the home page.
    "not_found_handling": "404-page"
  },
  // Contact form email addresses. The sender must use a domain verified in
  // Resend; RESEND_API_KEY is a secret (npx wrangler secret put RESEND_API_KEY).
  "vars": {
    "CONTACT_FROM_EMAIL": "Website Contact <onboarding@resend.dev>",
    "CONTACT_TO_EMAIL": "rainbowh9490@gmail.com"
  },
  // At most 3 contact form submissions per visitor IP per minute.
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  // Only the custom domains serve the site, so search engines see one copy.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ian030590.trainerhub.cc", "custom_domain": true },
    { "pattern": "ian.trainerhub.cc", "custom_domain": true }
  ]
}
