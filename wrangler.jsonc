{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ian",
  "compatibility_date": "2026-10-19",
  // Static site only: no Worker script, Cloudflare serves dist/ directly.
  "assets": {
    "directory": "./dist",
    // Same as Pages: /x.html redirects to /x, and /x serves x.html.
    "html_handling": "auto-trailing-slash",
    // Serve 404.html with a 404 status instead of the home page.
    "not_found_handling": "404-page"
  },
  // Only the custom domains serve the site, so search engines see one copy.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ian030590.trainerhub.cc", "custom_domain": true },
    { "pattern": "ian.trainerhub.cc", "custom_domain": true }
  ]
}
